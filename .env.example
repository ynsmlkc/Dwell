# Dwell sunucusu — ortam degiskenleri.
#
# Railway'de bunlar "Variables" sekmesine girilir. Bu dosya YALNIZCA ornek;
# gercek degerleri buraya YAZMA, `.env` git'e girmiyor ama bu dosya giriyor.

# ── zorunlu ──────────────────────────────────────────────────────

# SEP-10 imzalama anahtari. SABIT olmali: her yeniden baslatmada degisirse
# o an suren girisler sessizce bozulur. Uret:
#   node -e "console.log(require('@stellar/stellar-sdk').Keypair.random().secret())"
DWELL_SEP10_SECRET=S...

# Sunucunun herkese acik alan adi. SEP-10 challenge'i buna gore imzalanir;
# yanlissa cuzdanlar imzayi reddeder. Basinda https:// YOK.
DWELL_HOME_DOMAIN=dwell-api.up.railway.app

# IP hash'leme tuzu. Rastgele ve gizli. Degistirilirse eski hash'ler
# eslesmez — fraud kurallari gecmisi kaybeder.
DWELL_IP_SALT=

# ── odeme (bunlar olmadan odeme KAPALI kalir) ────────────────────

# Sicak cuzdanin gizli anahtari. Odemeler buradan cikar.
# Icinde ihtiyacin kadar USDC ve islem ucreti icin XLM olmali.
DWELL_HOT_SECRET=

# Odenecek varlik. Bos birakilirsa Circle'in testnet USDC'si kullanilir.
# DWELL_ASSET_CODE=USDC
# DWELL_ASSET_ISSUER=GBBD47IF6LWK7P7MDEVSCWR7DPUWV3NY3DTQEVFL4NAT4AQH3ZLLFLA5

# Kalici depolama. Railway'de bir Volume olusturup `/data`'ya baglayin.
# TANIMSIZ birakilirsa her sey BELLEKTE kalir ve her deploy'da bakiyeler
# silinir — sunucu acilista bunu gurultuyle uyarir.
DWELL_DB=/data/dwell.db

# ── istege bagli ─────────────────────────────────────────────────

# DWELL_HORIZON=https://horizon-testnet.stellar.org
# DWELL_PAYOUT_INTERVAL_MS=60000      # odeme turu araligi
# DWELL_PENDING_MS=30000              # dogrulama bekleme suresi (uretimde 24 saat)
# DWELL_WALLET_HOLD_MS=259200000      # cuzdan degisikligi sonrasi bekleme (72 saat)
